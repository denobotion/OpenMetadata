@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix om: <https://open-metadata.org/ontology/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# SHACL shapes for the OpenMetadata knowledge graph.
#
# Predicate names here MUST match what the RDF mapper actually emits
# (see openmetadata-service/src/main/java/org/openmetadata/service/rdf/translator/).
# A shape that references a predicate the mapper never produces silently
# passes for every entity, which gives us false confidence.
#
# Cardinality is intentionally permissive: many fields are optional in
# OpenMetadata schemas. Shapes flag genuine inconsistencies (missing
# label/FQN, dangling references, type mismatches), not stylistic gaps.

#################################################################
# Base Entity
#################################################################

om:EntityShape a sh:NodeShape ;
    sh:targetClass om:Entity ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Every om:Entity must carry exactly one rdfs:label (its name)."@en ;
    ] ;
    sh:property [
        sh:path om:fullyQualifiedName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every om:Entity must have exactly one om:fullyQualifiedName."@en ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "Description must be a single literal."@en ;
    ] ;
    sh:property [
        sh:path dct:hasVersion ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path om:hasOwner ;
        sh:nodeKind sh:IRI ;
        sh:message "om:hasOwner must reference a User or Team resource."@en ;
    ] .

#################################################################
# Tables and Columns
#################################################################

om:TableShape a sh:NodeShape ;
    sh:targetClass om:Table ;
    sh:property [
        sh:path om:hasColumn ;
        sh:class om:Column ;
        sh:minCount 1 ;
        sh:message "Table must declare at least one om:hasColumn link to an om:Column resource."@en ;
    ] ;
    sh:property [
        sh:path om:belongsToSchema ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path om:belongsToDatabase ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] .

om:ColumnShape a sh:NodeShape ;
    sh:targetClass om:Column ;
    sh:property [
        sh:path om:fullyQualifiedName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Column must carry the FQN it was minted from."@en ;
    ] ;
    sh:property [
        sh:path om:columnDataType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path om:ordinalPosition ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path om:isPrimaryKey ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path om:isNullable ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path om:isUnique ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path om:references ;
        sh:class om:Column ;
        sh:message "om:references must point at another om:Column resource (FK target)."@en ;
    ] .

om:TableConstraintShape a sh:NodeShape ;
    sh:targetClass om:TableConstraint ;
    sh:property [
        sh:path om:constraintType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("PRIMARY_KEY" "UNIQUE" "FOREIGN_KEY" "SORT_KEY" "DIST_KEY" "CLUSTER_KEY") ;
        sh:message "Constraint type must be one of the canonical TableConstraint enum values."@en ;
    ] ;
    sh:property [
        sh:path om:relationshipType ;
        sh:datatype xsd:string ;
        sh:in ("ONE_TO_ONE" "ONE_TO_MANY" "MANY_TO_ONE" "MANY_TO_MANY") ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path om:hasConstrainedColumn ;
        sh:class om:Column ;
        sh:minCount 1 ;
        sh:message "A TableConstraint must reference at least one constrained Column."@en ;
    ] ;
    sh:property [
        sh:path om:hasReferredColumn ;
        sh:class om:Column ;
    ] .

#################################################################
# Lineage
#################################################################

om:LineageDetailsShape a sh:NodeShape ;
    sh:targetClass om:LineageDetails ;
    sh:property [
        sh:path om:sqlQuery ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path om:lineageSource ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "If a pipeline produced this lineage, prov:wasGeneratedBy must reference exactly one resource."@en ;
    ] ;
    sh:property [
        sh:path om:hasColumnLineage ;
        sh:class om:ColumnLineage ;
    ] .

om:ColumnLineageShape a sh:NodeShape ;
    sh:targetClass om:ColumnLineage ;
    sh:property [
        sh:path om:fromColumn ;
        sh:class om:Column ;
        sh:message "om:fromColumn must reference an om:Column resource (URI), not an FQN literal — the FQN is carried by om:fromColumnFqn."@en ;
    ] ;
    sh:property [
        sh:path om:toColumn ;
        sh:class om:Column ;
        sh:maxCount 1 ;
        sh:message "om:toColumn must reference exactly one om:Column resource."@en ;
    ] ;
    sh:property [
        sh:path om:fromColumnFqn ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path om:toColumnFqn ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path om:transformFunction ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

# A DataAsset must not appear as both upstream and downstream of the same
# other asset — that's a self-cycle through a single edge, almost always a
# bug in lineage capture.
om:LineageCycleShape a sh:NodeShape ;
    sh:targetClass om:DataAsset ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Data asset is reported as both upstream and downstream of the same asset."@en ;
        sh:prefixes [ sh:declare [
            sh:prefix "om" ;
            sh:namespace "https://open-metadata.org/ontology/"^^xsd:anyURI ;
        ] ] ;
        sh:select """
            SELECT $this ?other
            WHERE {
                $this om:upstream ?other .
                $this om:downstream ?other .
            }
        """ ;
    ] .

#################################################################
# Containers
#################################################################

om:DatabaseShape a sh:NodeShape ;
    sh:targetClass om:Database ;
    sh:property [
        sh:path om:belongsToService ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] .

om:DatabaseSchemaShape a sh:NodeShape ;
    sh:targetClass om:DatabaseSchema ;
    sh:property [
        sh:path om:belongsToDatabase ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] .

#################################################################
# Governance: Glossary, Domain, DataProduct, Tag
#################################################################

om:GlossaryTermShape a sh:NodeShape ;
    sh:targetClass om:GlossaryTerm ;
    sh:property [
        sh:path skos:inScheme ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every glossary term must declare its parent glossary via skos:inScheme."@en ;
    ] ;
    sh:property [
        sh:path skos:broader ;
        sh:class om:GlossaryTerm ;
        sh:maxCount 1 ;
        sh:message "skos:broader must reference at most one parent term."@en ;
    ] ;
    sh:property [
        sh:path skos:narrower ;
        sh:class om:GlossaryTerm ;
    ] ;
    sh:property [
        sh:path skos:altLabel ;
        sh:datatype xsd:string ;
    ] .

om:TagShape a sh:NodeShape ;
    sh:targetClass om:Tag ;
    sh:property [
        sh:path skos:inScheme ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "Tag should declare its parent classification via skos:inScheme."@en ;
    ] ;
    sh:property [
        sh:path om:tagFQN ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

om:DomainShape a sh:NodeShape ;
    sh:targetClass om:Domain ;
    sh:property [
        sh:path om:domainType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path om:hasDataProduct ;
        sh:class om:DataProduct ;
    ] .

om:DataProductShape a sh:NodeShape ;
    sh:targetClass om:DataProduct ;
    sh:property [
        sh:path om:hasAsset ;
        sh:nodeKind sh:IRI ;
    ] .

#################################################################
# Quality
#################################################################

om:TestCaseShape a sh:NodeShape ;
    sh:targetClass om:TestCase ;
    sh:property [
        sh:path om:appliesToEntity ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "TestCase should record the FQN of the entity it tests."@en ;
    ] ;
    sh:property [
        sh:path om:hasStatus ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

#################################################################
# Services
#################################################################

om:ServiceShape a sh:NodeShape ;
    sh:targetClass om:Service ;
    sh:property [
        sh:path om:hasServiceType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .
